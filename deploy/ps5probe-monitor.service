[Unit]
Description=ps5probe stock monitor (Discord alerts)
After=network-online.target
Wants=network-online.target

[Service]
User=nico
WorkingDirectory=/home/nico/PS5ProTracker-py
# Re-executes itself when ps5probe/*.py or the config changes, so edits go live without a restart.
# xvfb-run gives Chromium a virtual display: GameStop and Newegg reject headless browsers.
ExecStart=/usr/bin/xvfb-run -a --server-args="-screen 0 1366x900x24" /home/nico/PS5ProTracker-py/.venv/bin/python -u -m ps5probe --monitor
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
