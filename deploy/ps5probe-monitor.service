[Unit]
Description=ps5probe stock monitor (Discord alerts)
After=network-online.target
Wants=network-online.target

[Service]
User=nico
WorkingDirectory=/home/nico/PS5ProTracker-py
# Re-executes itself when ps5probe/*.py or the config changes, so edits go live without a restart.
ExecStart=/home/nico/PS5ProTracker-py/.venv/bin/python -u -m ps5probe --monitor
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
